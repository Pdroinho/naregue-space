{
  "name": "naregua",
  "private": true,
  "version": "3.0.0",
  "description": "Gestão completa para barbearias",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "node scripts/build.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier -w .",
    "test": "node --import ./scripts/test-env.mjs --import tsx --test --test-force-exit server/*.test.ts server/routes/*.test.ts server/middleware/*.test.ts server/support/*.test.ts src/*.test.ts src/features/staff/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:migrations && npm run test:security && npm run test:whatsapp && npm run test:release && npm run build",
    "preflight": "node scripts/preflight.mjs",
    "start:production": "NODE_ENV=production node dist/server/index.js",
    "test:migrations": "node --experimental-strip-types --test server/whatsappInboxMigration.test.mjs server/whatsappReliabilityMigration.test.mjs server/auth51Migration.test.mjs server/legalCampaignMigration.test.mjs server/professionalsMigration.test.mjs server/teamAccessMigration.test.mjs",
    "test:security": "node --experimental-strip-types --test server/session.test.mjs server/secretCrypto.test.mjs server/externalUrl.test.mjs server/teamAccessPolicy.test.mjs",
    "test:whatsapp": "node --experimental-strip-types --test server/whatsappIntent.test.mjs server/whatsappWebhook.test.mjs server/whatsappMedia.test.mjs server/marketingCampaign.test.mjs",
    "test:release": "node scripts/stable-release-audit.mjs",
    "test:ui": "node scripts/check-product-ui.mjs",
    "test:panel-ui": "npm run build && node scripts/check-product-ui.mjs --audit && node scripts/check-product-ui.mjs --panel-states && node scripts/check-product-ui.mjs --panel-dialogs && node scripts/check-product-ui.mjs --interactions",
    "test:booking-ui": "node scripts/check-product-ui.mjs --booking-mobile",
    "test:settings-ui": "node scripts/check-product-ui.mjs --settings"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "chart.js": "4.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "7.18.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.0.0",
    "prettier": "^3.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  }
}
