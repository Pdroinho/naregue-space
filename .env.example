# Ambiente
NODE_ENV=production
PORT=3000
# Em Docker use 0.0.0.0; em deploy direto com proxy no host, 127.0.0.1 é mais restritivo.
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_PATH=../db_data/app.db
WHATSAPP_MEDIA_DIR=../media

# Origem principal da plataforma — somente origem, sem caminho
APP_BASE_URL=https://app.seudominio.com.br
VITE_APP_BASE_URL=https://app.seudominio.com.br
FRONTEND_ORIGIN=https://app.seudominio.com.br

# Console DEV
DEV_HOST=dev.app.seudominio.com.br
VITE_DEV_HOST=dev.app.seudominio.com.br
DEV_BOOTSTRAP_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_32_BYTES

# Segurança e criptografia — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_ENCRYPTION_KEY=SUBSTITUA_POR_CHAVE_BASE64URL_DE_32_BYTES
# Use outra chave de 32 bytes; ela protege os arquivos .sqlite.gz.enc de backup.
BACKUP_ENCRYPTION_KEY=SUBSTITUA_POR_OUTRA_CHAVE_BASE64URL_DE_32_BYTES

# Landing page, suporte e documentos legais
# O checkout, Termos e Privacidade têm rotas internas. URLs abaixo podem sobrescrever os links, se necessário.
VITE_SALES_URL=
VITE_SUPPORT_URL=https://seudominio.com.br/suporte
VITE_PRIVACY_URL=
VITE_TERMS_URL=

# Identificação legal obrigatória em produção — substitua pelos dados reais do fornecedor do SaaS.
LEGAL_PROVIDER_NAME=SUBSTITUA_PELA_RAZAO_SOCIAL_OU_NOME_EMPRESARIAL
LEGAL_PROVIDER_TAX_ID=SUBSTITUA_PELO_CNPJ_OU_CPF_APLICAVEL
LEGAL_PROVIDER_ADDRESS=SUBSTITUA_PELO_ENDERECO_COMERCIAL_COMPLETO
LEGAL_CONTACT_EMAIL=legal@seudominio.com.br
PRIVACY_CONTACT_EMAIL=privacidade@seudominio.com.br

# Cobrança InfinitePay
INFINITEPAY_HANDLE=SEU_HANDLE_REAL
INFINITEPAY_BASE_URL=https://api.checkout.infinitepay.io
# O catálogo oficial de preços vive em server/pricing.ts e é servido pela API pública.

# Assistant via OpenRouter
AI_ASSISTANT_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modelos da Assistant: chat barato em DeepSeek e setup/visão em Gemini.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_SETUP_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_VISION_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_BATCH_MODEL=deepseek/deepseek-v4-flash-0731

# Guardrails econômicos por tenant. Ajuste depois de medir o piloto real.
ASSISTANT_DAILY_REQUEST_LIMIT=40
ASSISTANT_MONTHLY_REQUEST_LIMIT=500
ASSISTANT_DAILY_COST_CAP_USD=0.10
ASSISTANT_MONTHLY_COST_CAP_USD=0.75
ASSISTANT_MAX_REQUEST_COST_USD=0.01
ASSISTANT_MAX_AGENT_STEPS=3
ASSISTANT_MAX_OUTPUT_TOKENS=700
ASSISTANT_MAX_IMAGE_BYTES=1048576

# Compatibilidade com instalações antigas; não configure junto com OPENROUTER_API_KEY.
OPENAI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-nano
OPENAI_VISION_MODEL=

# Domínios personalizados
CUSTOM_DOMAIN_CNAME_TARGET=domains.app.seudominio.com.br
CUSTOM_DOMAIN_IPV4=
CUSTOM_DOMAIN_IPV6=
DOMAIN_AUTH_SECRET=SUBSTITUA_POR_UM_SEGREDO_SEM_CARACTERES_ESPECIAIS
DOMAIN_VERIFY_INTERVAL_MINUTES=10
DOMAIN_ACTIVE_REVERIFY_HOURS=24

# Evolution API / WhatsApp. URL/key podem bootstrapar o primeiro MFA DEV; depois o painel DEV pode persistir a configuração global.
EVOLUTION_API_URL=https://evolution.seudominio.com.br
EVOLUTION_API_KEY=SUBSTITUA_POR_UMA_API_KEY_REAL
EVOLUTION_INSTANCE_NAME=naregua-global
EVOLUTION_WEBHOOK_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO


# Campanhas promocionais WhatsApp
# Mantenha false até validar provedor, conta, política aplicável e operação de opt-in/opt-out em produção.
WHATSAPP_PROMOTIONAL_CAMPAIGNS_ENABLED=false
WHATSAPP_CAMPAIGN_MAX_RECIPIENTS=50
WHATSAPP_CAMPAIGN_SEND_INTERVAL_SECONDS=15
